# Private configuration template. Complete all phase gates before production deployment.
PUBLIC_BASE_URL=https://example.invalid:5116
PUBLIC_PORT=5116
MCP_API_KEY=
MCP_API_KEY_PREVIOUS=
API_KEY_PREVIOUS_UNTIL=
TLS_CERT_DIR=./private/certs
STATE_DIR=./private/state
AUTHORITY_DIR=./private/authority
SESSION_MASTER_KEY_FILE=./private/secrets/session-master.key
CLIENT_ARTIFACT_DIR=./private/client-artifacts
PRIVATE_DOCKER_REGISTRY_HOST=

# Use an explicit compatible image SHA in production.
IMAGE_TAG=latest
# Dedicated certificate copy and optional prior acme hook argv JSON (private).
CERT_SOURCE_DIR=
CERT_PREVIOUS_RELOAD_JSON=[]

# Match the gateway process ownership; root deployment uses 0/0.
TLS_KEY_UID=0
TLS_KEY_GID=0
